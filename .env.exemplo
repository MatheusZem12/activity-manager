# Copie para .env e ajuste. Só é necessário para o backend — o app de desktop
# funciona sem nada disto.

# --- segurança ---
# Assina os tokens de sessão. Gere com: openssl rand -base64 48
AM_JWT_SEGREDO=
# Quem não tem este convite não cria conta.
AM_CONVITE=
AM_JWT_DIAS=30
AM_MAX_CONTAS=5

# --- portas no host ---
AM_PORTA=8090
# 5434 e não 5432: o 5432 costuma estar ocupado e o 5433 já é do Lingua.
AM_DB_PORTA=5434

# --- banco ---
AM_DB_NOME=activity_manager
AM_DB_USER=activity
AM_DB_SENHA=activity

# --- log ---
AM_LOG=INFO

# ---------------------------------------------------------------------------
# NÃO existe configuração de IA aqui.
#
# A escolha do provedor (claudecode, openai, gemini, anthropic, ollama) e a
# chave, quando houver, moram no dispositivo — cada máquina decide a sua, e o
# arquivo fica no userData do app, fora do backup exportável. O servidor nunca
# vê título de janela: ele recebe a categoria já decidida.
# ---------------------------------------------------------------------------

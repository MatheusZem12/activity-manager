# O backend. O `instalar.sh` cria o .env de verdade e gera os segredos.

# --- banco ---
# A mesma senha de ../postgres/.env (la o nome e POSTGRES_PASSWORD).
AM_DB_USER=activity
AM_DB_SENHA=

# --- seguranca ---
# Assina os tokens de sessao. Gere com: openssl rand -base64 48
# Trocar isto derruba a sessao de todos os aparelhos.
AM_JWT_SEGREDO=
# Quem nao tem este convite nao cria conta. Voce digita uma vez em cada
# dispositivo.
AM_CONVITE=
AM_JWT_DIAS=30
AM_MAX_CONTAS=5

# --- porta no host ---
AM_PORTA_HOST=8091

# --- imagem ---
# A tag que o Watchtower acompanha. `hmg` e a homologacao, que e o que roda
# nesta VPS; `main` seria producao. `dev` nao publica imagem nenhuma.
AM_TAG=hmg

# --- fila de classificacao ---
# NAO ha provedor nem chave de IA aqui, e e de proposito: o servidor nao fala
# com modelo nenhum. Ele monta a pergunta e o schema -- que e regra de negocio --
# e enfileira. Quem executa e sempre uma maquina do usuario, com o que ela tiver.
#
# Prazo da reserva de uma tarefa por um dispositivo, em minutos. Maquina que
# desliga no meio devolve a tarefa sozinha quando isto vence.
AM_IA_RESERVA=10

# --- tunel (Cloudflare) ---
# Token do painel: Zero Trust > Networks > Tunnels > seu tunel.
# Enquanto estiver vazio, o perfil `tunel` nao sobe e nada e exposto.
AM_TUNEL_TOKEN=

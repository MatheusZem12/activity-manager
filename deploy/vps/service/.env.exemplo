# O backend. O `instalar.sh` cria o .env de verdade e gera os segredos.

# --- banco ---
# A mesma senha de ../postgres/.env (la o nome e POSTGRES_PASSWORD).
AM_DB_USER=activity
AM_DB_SENHA=

# --- seguranca ---
# Assina os tokens de sessao. Gere com: openssl rand -base64 48
# Trocar isto derruba a sessao de todos os aparelhos.
AM_JWT_SEGREDO=
# Quem nao tem este convite nao cria conta. Voce digita uma vez em cada
# dispositivo.
AM_CONVITE=
AM_JWT_DIAS=30
AM_MAX_CONTAS=5

# --- porta no host ---
AM_PORTA_HOST=8091

# --- imagem ---
# A tag que o Watchtower acompanha: `dev` ou `main`.
AM_TAG=dev

# --- IA ---
# `local` = o servidor NAO chama modelo nenhum: ele monta a pergunta e um
# dispositivo seu executa no ollama ou no claude daquela maquina. E o unico
# modo em que a VPS nao precisa de chave.
#
# Para o servidor classificar sozinho, troque para anthropic, openai ou gemini
# e preencha AM_IA_CHAVE.
AM_IA_PROVEDOR=local
AM_IA_CHAVE=
AM_IA_MODELO=claude-haiku-4-5
AM_IA_RESERVA=10

# --- tunel (Cloudflare) ---
# Token do painel: Zero Trust > Networks > Tunnels > seu tunel.
# Enquanto estiver vazio, o perfil `tunel` nao sobe e nada e exposto.
AM_TUNEL_TOKEN=
